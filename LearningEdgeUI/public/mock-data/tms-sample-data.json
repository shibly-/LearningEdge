{
  "_readme": {
    "purpose": "Sample data for every page while the API is incomplete. Served as a static asset from /mock-data/tms-sample-data.json and fetched over HTTP at bootstrap, so replacing it with real REST endpoints is a URL change in the repository layer, not a code rewrite.",
    "replacingThisFile": "Each collection below mirrors the response of a live endpoint (plain DTOs; errors are ProblemDetails). Flip environment.useMockApi to false and the Http* repositories take over; this file is then ignored. Assignments, results, messages and processingJobs have no backend endpoint yet and stay mock-only.",
    "pageToCollection": {
      "/platform (Platform overview)": [
        "organizations"
      ],
      "/platform/organizations (+ detail)": [
        "organizations"
      ],
      "/platform/org-admins": [
        "organizations"
      ],
      "/dashboard/admin": [
        "users",
        "categories",
        "trainings",
        "assignments",
        "results"
      ],
      "/dashboard/staff": [
        "trainings",
        "assignments",
        "results"
      ],
      "/users (+ detail)": [
        "users"
      ],
      "/categories": [
        "categories"
      ],
      "/trainings (+ assign, category view)": [
        "trainings",
        "categories",
        "users"
      ],
      "/processing": [
        "processingJobs"
      ],
      "/portal (Learner)": [
        "assignments",
        "results"
      ],
      "/staff-ops": [
        "users",
        "assignments",
        "messages"
      ]
    },
    "conventions": {
      "dates": "Any date field accepts a full ISO string OR a relative offset so the samples never go stale: '+14d' is 14 days from load, '-3d' is 3 days ago, '0d' is now. The loader resolves these to ISO strings.",
      "role": "Numeric, matching the backend enum: 1 Learner, 2 Instructor, 3 OrgAdmin, 4 SysAdmin.",
      "ids": "Stable string ids. Real records use GUIDs generated server-side.",
      "tenancy": "Every collection except organizations carries organizationId. Stores filter by the active tenant, so cross-tenant rows here are intentional test coverage."
    }
  },
