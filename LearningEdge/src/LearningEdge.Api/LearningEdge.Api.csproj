<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
	
  <ItemGroup>
    <ProjectReference Include="..\..\aspires\LearningEdge.ServiceDefaults\LearningEdge.ServiceDefaults.csproj" />
    <ProjectReference Include="..\LearningEdge.Application\LearningEdge.Application.csproj" />
    <ProjectReference Include="..\LearningEdge.Infrastructure.Migrations\LearningEdge.Infrastructure.Migrations.csproj" />
