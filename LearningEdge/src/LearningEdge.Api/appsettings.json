{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.IdentityModel": "Debug",
      "Microsoft.AspNetCore.Authentication": "Debug"
    }
  },
  "Redis": {
    "Connection": "127.0.0.1:6380"
  },
  "OutputCache": {
    "DefaultQueryCache": {
      "ExpiryPeriodInSeconds": 30
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "RootPath": "uploads"
  },
  "ConnectionStrings": {
    "DefaultConnectionLocal": "Server=localhost\\SQLEXPRESS;Database=LearningEdgeDB;User Id=sqluser;Password=password;TrustServerCertificate=True;",
    "DefaultConnection": "Server=localhost,11433;Database=LearningEdgeDB;User Id=sqluser;Password=P@ssw0rd;TrustServerCertificate=True;"
  },
  "MigrationsAssembly": "LearningEdge.Infrastructure.Migrations",
  "RabbitMQ": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "FileExtractRequestEvent": "le-file-extract-requested",
    "FileExtractCompletedQueue": "le-file-extract-completed",
    "QuestionGenerationRequestEvent": "le-question-generation-requested",
    "QuestionGenerationCompletedQueue": "le-question-generation-completed"
  },
  "Cors": {
    "Policy": "AllowWebApp",
    "Origin": "http://localhost:4200"
  },
  "RateLimiter": {
    "TokenBucket": {
      "PolicyName": "api",
      "TokenLimit": 100,
      "TokensPerPeriod": 20,
      "ReplenishmentPeriodInSeconds": 10,
      "QueueLimit": 10
    }
  },
  "APIInfo": {
    "Name": "LearningEdge"
  },
  "Keycloak": {
    "Provider": "Keycloak",
    "Authority": "https://localhost:8443/realms/learningedge",
    "AuthorizationUrl": "https://localhost:8443/realms/learningedge/protocol/openid-connect/auth",
    "TokenUrl": "https://localhost:8443/realms/learningedge/protocol/openid-connect/token",
    "ScopesOpenid": "OpenID Connect",
    "ScopesProfile": "User Profile",
    "RequireHttpsMetadata": true,
    "ConfigurationMetadataURL": "https://localhost:8443/realms/learningedge/.well-known/openid-configuration",
    "APIClientId": "le-web-api",
    "UIClientId": "le-web-ui",
    "ScalarClientId": "le-scalar-ui",
    "RefreshInterval": 5,
    "AutomaticRefreshInterval": 12
  },
  "OpenApi": {
    "v1": {
      "Title": "LearningEdge API",
      "Version": "v1"
    },
    "v2": {
      "Title": "LearningEdge API - Extended",
      "Version": "v2"
    }
  }
}
