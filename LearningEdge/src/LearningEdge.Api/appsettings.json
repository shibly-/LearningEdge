{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Redis": {
    "Connection": "127.0.0.1:6380"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "RootPath": "uploads"
  },
  "ConnectionStrings": {
    "DefaultConnectionLocal": "Server=localhost\\SQLEXPRESS;Database=LearningEdgeDB;User Id=sqluser;Password=password;TrustServerCertificate=True;",
    "DefaultConnection": "Server=localhost,11433;Database=LearningEdgeDB;User Id=sqluser;Password=P@ssw0rd;TrustServerCertificate=True;"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "FileExtractRequestEvent": "le-file-extract-requested",
    "FileExtractCompletedQueue": "le-file-extract-completed",
    "QuestionGenerationRequestEvent": "le-question-generation-requested",
    "QuestionGenerationCompletedQueue": "le-question-generation-completed"
  },
  "AngularApp": {
    "URL": "http://localhost:4200"
  }
}
